#!/usr/bin/env bash
# Installs and configures Nginx web server to serve "Holberton School for the win!"

apt-get update -y
apt-get install -y nginx

mkdir -p /var/www/html /usr/share/nginx/html
echo "Holberton School for the win!" | tee /var/www/html/index.html /var/www/html/index.nginx-debian.html /usr/share/nginx/html/index.html

service nginx restart
