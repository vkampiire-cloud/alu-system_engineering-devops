#!/usr/bin/env bash
# Configures Nginx with a 301 redirection for /redirect_me

apt-get update -y
apt-get install -y nginx

mkdir -p /var/www/html /usr/share/nginx/html
echo "Holberton School for the win!" | tee /var/www/html/index.html /var/www/html/index.nginx-debian.html /usr/share/nginx/html/index.html

sed -i '/^[[:space:]]*server_name/a \    rewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default
sed -i '/^[[:space:]]*server_name/a \    rewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-enabled/default 2>/dev/null

service nginx restart
