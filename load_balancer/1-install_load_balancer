#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to distribute traffic with roundrobin

apt-get update -y
apt-get install -y haproxy

# Enable HAProxy init script
if grep -q "ENABLED=0" /etc/default/haproxy 2>/dev/null; then
    sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy
elif ! grep -q "ENABLED=1" /etc/default/haproxy 2>/dev/null; then
    echo "ENABLED=1" >> /etc/default/haproxy
fi

# Configure frontend and backend for roundrobin load balancing
if ! grep -q "frontend lb-frontend" /etc/haproxy/haproxy.cfg; then
cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend lb-frontend
    bind *:80
    mode http
    default_backend lb-backend

backend lb-backend
    balance roundrobin
    server 7314-web-01 18.130.99.55:80 check
    server 7314-web-02 18.130.123.188:80 check
EOF
fi

service haproxy restart
